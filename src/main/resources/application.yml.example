# Все настройки процесса: админка, путь к базе и API-ключи бирж. Файл .env не используется.
#
# Где бот ищет application.yml (первый найденный):
#   1) рядом с jar / в папке запуска (или java -Dconfig.file=/путь/application.yml -jar ...)
#      — перечитывается на лету: новые ключи бирж применяются при «Остановить» → «Поднять соединения»;
#   2) src/main/resources/application.yml — собирается внутрь jar, меняется только пересборкой.
#      ВНИМАНИЕ: ключи окажутся внутри jar — не передавайте и не выкладывайте такой jar.
#
#   cp src/main/resources/application.yml.example application.yml && chmod 600 application.yml
#
# application.yml в .gitignore и в git не попадает. Пустые значения игнорируются.
# Блоки admin и storage применяются только при старте бота.
# Переменная окружения с тем же именем (ADMIN_TOKEN, BINANCE_API_KEY…) используется,
# только если в файле значения нет.
# Ключи — только с правом торговли, без вывода, с привязкой к IP сервера.

admin:
  enabled: true
  port: 8080
  token: ""          # обязательно задайте длинный случайный токен

storage:
  state-db: data/state.db   # SQLite с выбором бирж и параметрами

keys:
  binance:           # тестовые ключи: https://testnet.binance.vision
    api-key: ""
    api-secret: ""
  bybit:             # тестовые ключи: https://testnet.bybit.com
    api-key: ""
    api-secret: ""
  okx:
    api-key: ""
    api-secret: ""
    passphrase: ""   # фраза, заданная при создании ключа
  gate:
    api-key: ""
    api-secret: ""
  mexc:
    api-key: ""
    api-secret: ""
  bingx:
    api-key: ""
    api-secret: ""
  kucoin:
    api-key: ""
    api-secret: ""
    passphrase: ""   # фраза, заданная при создании ключа
  aster:
    api-key: ""      # адрес основного кошелька (user)
    api-secret: ""   # приватный ключ API-кошелька (signer, без права вывода)
  hyperliquid:
    api-key: ""      # адрес основного аккаунта
    api-secret: ""   # ключ agent-кошелька (без права вывода)
  uniswapv2:
    api-key: ""      # метка/адрес
    api-secret: ""   # ключ горячего кошелька
