# Скопируйте в .env (cp .env.example .env), заполните и защитите: chmod 600 .env
# .env в .gitignore и в git не попадает. Бот сам читает .env из рабочей папки
# (другой путь — переменная ENV_FILE) и перечитывает его при изменении.
#
# Приоритет: .env > export / systemd Environment=. Пустые значения пропускаются.
# Когда применяется:
#   *_API_KEY / *_API_SECRET / *_PASSPHRASE — при следующем «Поднять соединения» (Остановить → Поднять);
#   *_TESTNET / *_LIVE — при перезапуске бота (важнее значения, сохранённого из админки)
#                        и как значение по умолчанию при выборе биржи;
#   ADMIN_* и STATE_DB — при перезапуске бота.
# *_TESTNET=true  — тестовая сеть биржи (если она есть); false — основная сеть.
# *_LIVE=true     — реальные ордера (нужны ключи); false — бумажная торговля на живых данных.
# Пусто — режим берётся из админки (по умолчанию testnet=true, где он есть, и live=false).
# Тикеры здесь не задаются — они выбираются в админке во время работы.
# Ключи — только с правом торговли, без вывода, с привязкой к IP сервера.

# ───── Админка
ADMIN_PORT=8080
# Токен доступа к API (заголовок X-Admin-Token). Пусто — бот при старте сгенерирует его и запишет сюда.
ADMIN_TOKEN=
# Адрес, на котором слушает админка: 127.0.0.1 — только этот компьютер (снаружи — SSH-туннель).
# 0.0.0.0 открывает доступ по сети — только за файрволом/VPN.
ADMIN_BIND=127.0.0.1
# Адреса веб-админки для браузера (CORS), через запятую. Пусто — CORS открыт для всех (на время тестирования).
# ADMIN_CORS_ORIGINS=https://admin.example.com
# STATE_DB=data/state.db


# ───── Binance — тестовые ключи: https://testnet.binance.vision
BINANCE_TESTNET=
BINANCE_LIVE=
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ───── Bybit — тестовые ключи: https://testnet.bybit.com
BYBIT_TESTNET=
BYBIT_LIVE=
BYBIT_API_KEY=
BYBIT_API_SECRET=

# ───── OKX — демо-торговля; нужна ещё фраза ключа
OKX_TESTNET=
OKX_LIVE=
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# ───── Gate
GATE_TESTNET=
GATE_LIVE=
GATE_API_KEY=
GATE_API_SECRET=

# ───── MEXC — тестовой сети нет
# тестовой сети нет: MEXC_TESTNET=true будет отклонён
MEXC_TESTNET=
MEXC_LIVE=
MEXC_API_KEY=
MEXC_API_SECRET=

# ───── KuCoin — тестовой сети нет; нужна ещё фраза ключа
# тестовой сети нет: KUCOIN_TESTNET=true будет отклонён
KUCOIN_TESTNET=
KUCOIN_LIVE=
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_PASSPHRASE=
# Счёт KuCoin в режиме UTA (единый торговый счёт): true — ордера по WS через uta.order/uta.cancel
KUCOIN_UTA=

# ───── Aster — KEY — адрес основного кошелька (user), SECRET — ключ API-кошелька (signer, без вывода)
ASTER_TESTNET=
ASTER_LIVE=
ASTER_API_KEY=
ASTER_API_SECRET=

# ───── Hyperliquid — KEY — адрес основного аккаунта, SECRET — ключ agent-кошелька (без вывода)
HYPERLIQUID_TESTNET=
HYPERLIQUID_LIVE=
HYPERLIQUID_API_KEY=
HYPERLIQUID_API_SECRET=

# ───── Uniswap V2 — KEY — метка/адрес, SECRET — ключ горячего кошелька; тестовая сеть — через restUrl в админке
# UNISWAPV2_TESTNET=true — только вместе с restUrl тестовой сети в админке
UNISWAPV2_TESTNET=
UNISWAPV2_LIVE=
UNISWAPV2_API_KEY=
UNISWAPV2_API_SECRET=
