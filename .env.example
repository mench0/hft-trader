# Скопируйте в .env (cp .env.example .env) и заполните. .env в .gitignore и в git не попадает.
# Бот сам читает .env из рабочей папки (другой путь — переменная ENV_FILE) и перечитывает его
# при изменении: новые ключи бирж применяются при следующем «Поднять соединения» без перезапуска.
# ADMIN_* и STATE_DB — после перезапуска процесса. Значения из .env важнее export в shell.
# Менять можно и из админки: вкладка «Окружение» (POST /env).
# Ключи — только с правом торговли, без вывода, с привязкой к IP.

# Админка
ADMIN_PORT=8080
ADMIN_TOKEN=
# STATE_DB=data/state.db

# Binance (тестовые ключи: https://testnet.binance.vision)
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Bybit (тестовые ключи: https://testnet.bybit.com)
BYBIT_API_KEY=
BYBIT_API_SECRET=
# OKX: ещё фраза, заданная при создании ключа
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
GATE_API_KEY=
GATE_API_SECRET=
MEXC_API_KEY=
MEXC_API_SECRET=
BINGX_API_KEY=
BINGX_API_SECRET=
# KuCoin: ещё фраза, заданная при создании ключа
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_PASSPHRASE=
# Aster: адрес основного кошелька и приватный ключ API-кошелька (агента без права вывода)
ASTER_API_KEY=
ASTER_API_SECRET=
# Hyperliquid: адрес основного аккаунта и ключ agent-кошелька (без права вывода)
HYPERLIQUID_API_KEY=
HYPERLIQUID_API_SECRET=
# Uniswap V2: метка/адрес и ключ горячего кошелька
UNISWAPV2_API_KEY=
UNISWAPV2_API_SECRET=
