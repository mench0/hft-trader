# Скопируйте в .env и заполните. .env уже в .gitignore.
# Ключи Testnet берутся на https://testnet.binance.vision

BINANCE_API_KEY=
BINANCE_API_SECRET=

# Подключение (без пересборки jar). Торговые параметры (символы, риск, стратегия)
# задаются через админку: POST /exchange/params?exchange=binance&...
BINANCE_TESTNET=true
ADMIN_PORT=8080
ADMIN_TOKEN=
