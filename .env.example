# Скопируйте в .env и заполните. .env уже в .gitignore.
# Ключи Testnet берутся на https://testnet.binance.vision

BINANCE_API_KEY=
BINANCE_API_SECRET=

# Подключение (без пересборки jar). Торговые параметры (символы, риск, стратегия)
# задаются через админку: POST /exchange/params?exchange=binance&...
BINANCE_TESTNET=true
ADMIN_PORT=8080
ADMIN_TOKEN=

# KuCoin: ключ, секрет и фраза, заданная при создании ключа
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_PASSPHRASE=
# Aster: адрес основного кошелька и приватный ключ API-кошелька (агента без права вывода)
ASTER_API_KEY=
ASTER_API_SECRET=
